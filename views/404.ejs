<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="description" content="Page not found on Harsh Solanki’s portfolio.">
    <title>Page not found | Harsh Solanki</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="not-found-page" id="main-content">
        <p class="eyebrow"><%= typeof serverError !== 'undefined' && serverError ? 'Something went wrong' : '404 · Page not found' %></p>
        <h1><%= typeof serverError !== 'undefined' && serverError ? 'Please try again later.' : 'This page isn’t here.' %></h1>
        <p><%= typeof serverError !== 'undefined' && serverError ? 'The request could not be completed.' : 'The link may be out of date, or the page may have moved.' %></p>
        <a class="primary-btn" href="/">Back to home <span aria-hidden="true">→</span></a>
    </main>
    <script src="/js/script.js"></script>
</body>
</html>
